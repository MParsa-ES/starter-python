meta {
  name: 02 - Get Risk Assessment by ID (200)
  type: http
  seq: 2
}

get {
  url: http://localhost:8084/api/v1/risk-assessments/{{last_decision_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_access_token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Returns full transaction snapshot", function() {
    const body = res.getBody();
    expect(body.decision_id).to.equal(bru.getVar("last_decision_id"));
    expect(body.transfer_type).to.equal("INTERNAL");
    expect(body.amount).to.equal(2500000);
    expect(body.currency).to.equal("IRR");
  });
}
