meta {
  name: 03 - Create Active REVIEW Rule as Manager (201)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/risk-rules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{manager_access_token}}
}

body:json {
  {
    "name": "Bruno Manual Review Threshold",
    "type": "AMOUNT_LIMIT",
    "parameters": {
      "max_amount": 1000000,
      "decision": "REVIEW"
    },
    "enabled": true
  }
}

tests {
  test("Manager creates enabled REVIEW rule", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().enabled).to.equal(true);
    expect(res.getBody().parameters.decision).to.equal("REVIEW");
  });
}