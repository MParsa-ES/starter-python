meta {
  name: 08 - Reject Decision on Unclaimed OPEN Item (409)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/manual-review-queue/{{review_item_id}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operator_access_token}}
}

body:json {
  {
    "decision": "REJECT",
    "reason": "Attempting decision before claiming"
  }
}

tests {
  test("Deciding an OPEN item returns 409 CONFLICT", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().code).to.equal("CONFLICT");
  });
}