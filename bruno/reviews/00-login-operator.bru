meta {
  name: 00 - Obtain Operator JWT (200)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/token/
  body: json
  auth: none
}

body:json {
  {
    "username": "{{operatorUsername}}",
    "password": "{{operatorPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("operator_access_token", res.getBody().access);
  }
}

tests {
  test("Operator login returns 200 and access token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().access).to.be.a("string");
  });
}