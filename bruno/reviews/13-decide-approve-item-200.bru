meta {
  name: 13 - Record Final APPROVE Decision (200)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/manual-review-queue/{{review_item_id}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operator_access_token}}
}

headers {
  X-Correlation-ID: bruno-decide-001
  Idempotency-Key: {{decision_idempotency_key}}
}

body:json {
  {
    "decision": "APPROVE",
    "reason": "Verified customer identity and transfer legitimacy"
  }
}

script:pre-request {
  const uuidv4 = () =>
    "10000000-1000-4000-8000-100000000000".replace(/[018]/g, c =>
      (c ^ (Math.random() * 16) >> (c / 4)).toString(16)
    );
  bru.setVar("decision_idempotency_key", uuidv4());
}

tests {
  test("Decision transitions item to DECIDED and echoes X-Correlation-ID", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.item_id).to.equal(bru.getVar("review_item_id"));
    expect(body.state).to.equal("DECIDED");
    expect(res.getHeader("x-correlation-id")).to.equal("bruno-decide-001");
  });
}