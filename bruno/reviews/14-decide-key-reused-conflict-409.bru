meta {
  name: 14 - Reject Reused Decision Idempotency-Key with Different Body (409)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/manual-review-queue/{{review_item_id}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{operator_access_token}}
}

headers {
  Idempotency-Key: {{decision_idempotency_key}}
}

body:json {
  {
    "decision": "REJECT",
    "reason": "Different payload with same key"
  }
}

tests {
  test("Reusing Idempotency-Key with modified body returns 409 IDEMPOTENCY_KEY_REUSED", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().code).to.equal("IDEMPOTENCY_KEY_REUSED");
  });
}