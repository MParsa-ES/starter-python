# --- Service Metadata ---
SERVICE_NAME=s4-rsk
PORT=8084
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-s4-rsk-labbank
ALLOWED_HOSTS=localhost,127.0.0.1,s4-rsk,0.0.0.0

# --- CORS (frontend dev server origins, comma separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- PostgreSQL Database (Isolated per Service) ---
POSTGRES_DB=s4_rsk_db
POSTGRES_USER=s4_rsk_user
POSTGRES_PASSWORD=s4_rsk_password
POSTGRES_HOST=localhost
# Host execution reaches the Compose database on 5434.
# Compose overrides HOST/PORT for the application container only.
POSTGRES_PORT=5434

# --- Neighboring Services (GEN-15 Default Ports) ---
S1_ACC_BASE_URL=http://s1-acc:8081
S2_LDG_BASE_URL=http://s2-ldg:8082
S3_PAY_BASE_URL=http://s3-pay:8083
S3_PAY_WEBHOOK_TIMEOUT_SECONDS=5
S3_PAY_WEBHOOK_MAX_RETRIES=3
